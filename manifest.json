{
  "manifest_version": 3,
  "name": "Engineering Efficiency Ltd - CAFM Asset + PPM Importer v8.0.13",
  "version": "8.0.13",
  "description": "Engineering Efficiency CAFM Asset + PPM importer v8.0.13: modular page-based architecture; uses the trailing # on the PPM-register URL as the parent rule.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [
    "http://concept/*",
    "https://concept/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://concept/*",
        "https://concept/*"
      ],
      "js": [
        "src/bootstrap.js",
        "src/core/constants.js",
        "src/core/text.js",
        "src/core/dom.js",
        "src/core/lookup-spec.js",
        "src/core/pages.js",
        "src/core/storage.js",
        "src/workflow/phases.js",
        "src/runtime/host.js",
        "src/data/ppm.js",
        "src/pages/ppm-mappings.js",
        "src/pages/ppm-register.js",
        "src/pages/ppm-editor.js",
        "src/pages/registry.js",
        "xlsx_reader.js",
        "asset_rules.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Engineering Efficiency Ltd - CAFM Asset + PPM Importer v8.0.13",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "branding/engineering_efficiency_logo.png"
      ],
      "matches": [
        "http://concept/*",
        "https://concept/*"
      ]
    }
  ]
}